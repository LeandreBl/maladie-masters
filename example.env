# Copier en .env à la racine, à côté de docker-compose.yml.
# Postgres et le backend lisent ce fichier tel quel (env_file). Le backend
# valide chaque variable au démarrage et refuse de se lancer si une valeur est
# invalide, en expliquant laquelle et comment l'obtenir : la liste complète,
# avec valeurs par défaut, est dans backend/src/config/env.ts.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=maladie_masters
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maladie_masters
# Exposé sur 127.0.0.1 uniquement, pour `npm run start:dev` et prisma en local.
# POSTGRES_PORT=5433

# --- Redis (temps réel) ----------------------------------------------------
# Le backend y publie les événements, websocket-relay les pousse aux fronts.
# Obligatoire. Générer avec : openssl rand -base64 32
REDIS_PASSWORD=change-me
# Exposé sur 127.0.0.1 uniquement, pour `npm run start:dev` en local.
# REDIS_PORT=6380
# Port publié du relais websocket (le conteneur écoute sur 3000).
# WEBSOCKET_RELAY_PORT=3006

# --- Backend ------------------------------------------------------------------
# Compte de service Firebase, déposé dans secrets/ (monté en lecture seule).
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Administrateurs garantis au démarrage (emails séparés par des virgules).
ADMINS=toi@exemple.fr
# Origines autorisées (front joueur + panel admin).
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
# Contact exigé par Wikimedia dans le User-Agent (URL du projet ou email).
WIKIMEDIA_CONTACT=
# SWAGGER_ENABLED=true

# Bot Discord qui annonce les cartes légendaires (vide : désactivé). Les trois
# vont ensemble, voir « Le bot Discord » dans le README.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# THROTTLE_DEFAULT_PER_MINUTE=300
# THROTTLE_PACK_PER_MINUTE=30
# Plafond par adresse IP, toutes routes confondues (une école partage une IP).
# THROTTLE_IP_PER_MINUTE=1200
# TRUST_PROXY=1
# URL publique de l'API, ajoutée comme serveur dans le document OpenAPI.
# BACKEND_PUBLIC_URL=http://localhost:3005
# Port publié sur l'hôte (le conteneur écoute toujours sur 3000).
# BACKEND_PORT=3005
# uid:gid du conteneur, propriétaire de secrets/ sur l'hôte.
# BACKEND_UID=1000
# BACKEND_GID=1000

# --- Fronts (inlinés au build : config publique) -----------------------------
PUBLIC_BACKEND_URL=http://localhost:3005
# Adresse du relais websocket vue par le navigateur.
PUBLIC_WEBSOCKET_URL=ws://localhost:3006/ws
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# FRONTEND_PORT=5173
# ADMIN_PANEL_PORT=5174

# --- VPS derrière Traefik ----------------------------------------------------
# Décommenter sur le VPS : `docker compose up -d --build` utilise alors les
# labels Traefik au lieu de publier les ports (docker-compose.override.yml est
# ignoré).
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# API_HOST=api.maladie-masters.example.com
# FRONTEND_HOST=maladie-masters.example.com
# ADMIN_HOST=admin.maladie-masters.example.com
# Réseau Docker externe de Traefik, entrypoint HTTPS et certresolver.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# Entrypoint HTTP (:80), qui ne fait que rediriger vers HTTPS.
# TRAEFIK_HTTP_ENTRYPOINT=web
# Et adapter en conséquence :
# PUBLIC_BACKEND_URL=https://api.maladie-masters.example.com
# Le relais est servi sur le même hôte que l'API, chemin /ws.
# PUBLIC_WEBSOCKET_URL=wss://api.maladie-masters.example.com/ws
# FRONTEND_ORIGIN=https://maladie-masters.example.com,https://admin.maladie-masters.example.com
# BACKEND_ALLOWED_HOSTS=api.maladie-masters.example.com
# TRUST_PROXY=1
