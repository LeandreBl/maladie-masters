# Lancement hors Docker (`npm run start:dev`). Variables validées au démarrage :
# liste complète, valeurs par défaut et aide dans src/config/env.ts.
PORT=3005
DATABASE_URL=postgresql://maladie_masters:change-me@localhost:5433/maladie_masters
GOOGLE_APPLICATION_CREDENTIALS=../secrets/firebase-service-account.json
ADMINS=toi@exemple.fr
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
WIKIMEDIA_CONTACT=
# Redis de docker compose (REDIS_PORT), même mot de passe que le .env racine.
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=change-me
