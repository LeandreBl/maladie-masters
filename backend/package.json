{
    "name": "maladie-masters-backend",
    "version": "0.1.0",
    "description": "Backend API for maladie-masters, a trading card game made of diseases",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "main": "dist/src/main.js",
    "scripts": {
        "build": "nest build",
        "openapi:generate": "nest build && node dist/src/openapi.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:migrate:status": "prisma migrate status",
        "prisma:push": "prisma db push",
        "prisma:studio": "prisma studio",
        "start": "nest start",
        "start:debug": "nest start --debug 9229 --watch",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/src/main.js",
        "sync:diseases": "node dist/src/sync-cli.js",
        "test": "TS_NODE_TRANSPILE_ONLY=1 node --require ts-node/register --test \"src/**/*.spec.ts\""
    },
    "dependencies": {
        "@nestjs/common": "^11.1.17",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.17",
        "@nestjs/platform-express": "^11.1.17",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "firebase-admin": "^14.4.0",
        "helmet": "^8.3.0",
        "ioredis": "^5.11.1",
        "nestjs-pino": "^4.6.1",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.8.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.17",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.15.21",
        "@types/express": "^5.0.6",
        "@types/node": "^25.5.0",
        "@types/pg": "^8.20.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.2"
    },
    "overrides": {
        "multer": "^2.4.0",
        "@prisma/config": {
            "deepmerge-ts": "^8.0.2"
        },
        "prisma": {
            "mysql2": "^3.24.4"
        },
        "gaxios@6": {
            "uuid": "^11.1.1"
        }
    }
}
